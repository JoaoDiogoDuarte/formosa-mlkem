param int SHAKE128_RATE = 168;
param int SHAKE256_RATE = 136;
param int SHA3_256_RATE = 136;
param int SHA3_512_RATE = 72;

param int KECCAK_ROUNDS = 24;

u64[24] KECCAK1600_RC =
{  0x0000000000000001
  ,0x0000000000008082
  ,0x800000000000808a
  ,0x8000000080008000
  ,0x000000000000808b
  ,0x0000000080000001
  ,0x8000000080008081
  ,0x8000000000008009
  ,0x000000000000008a
  ,0x0000000000000088
  ,0x0000000080008009
  ,0x000000008000000a
  ,0x000000008000808b
  ,0x800000000000008b
  ,0x8000000000008089
  ,0x8000000000008003
  ,0x8000000000008002
  ,0x8000000000000080
  ,0x000000000000800a
  ,0x800000008000000a
  ,0x8000000080008081
  ,0x8000000000008080
  ,0x0000000080000001
  ,0x8000000080008008
};

u64[25] RHO_OFFSETS = {
   0x0000000000000000
  ,0x0000000000000001
  ,0x000000000000003e
  ,0x000000000000001c
  ,0x000000000000001b
  ,0x0000000000000024
  ,0x000000000000002c
  ,0x0000000000000006
  ,0x0000000000000037
  ,0x0000000000000014
  ,0x0000000000000003
  ,0x000000000000000a
  ,0x000000000000002b
  ,0x0000000000000019
  ,0x0000000000000027
  ,0x0000000000000029
  ,0x000000000000002d
  ,0x000000000000000f
  ,0x0000000000000015
  ,0x0000000000000008
  ,0x0000000000000012
  ,0x0000000000000002
  ,0x000000000000003d
  ,0x0000000000000038
  ,0x000000000000000e
};

inline fn keccakf1600_index(inline int x y) -> inline int
{
  inline int r;
  r = (x % 5) + 5 * (y % 5);
  return r;
}

inline fn keccakf1600_rhotates(inline int x y) -> inline int
{
  inline int i r;
  i = keccakf1600_index(x, y);
  r = RHO_OFFSETS[i];
  return r;
}

// C[x] = A[x,0] ^ A[x,1] ^ A[x,2] ^ A[x,3] ^ A[x,4]
inline fn keccakf1600_theta_sum(reg ptr u64[25] a) -> reg u64[5]
{
  inline int x y;
  reg u64[5] c;

  // C[x] = A[x, 0]
  for x=0 to 5
  { c[x] = a[x + 0]; }

  // C[x] ^= A[x,1] ^ A[x,2] ^ A[x,3] ^ A[x,4]
  for y=1 to 5
  { for x=0 to 5
    { c[x] ^= a[x + y*5]; }
  }

  return c;
}

// D[x] = C[x-1] ^ ROT(C[x+1], 1)
inline fn keccakf1600_theta_rol(reg u64[5] c) -> reg u64[5]
{
  inline int x;
  reg u64[5] d;
  
  for x = 0 to 5
  { // D[x] = C[x + 1]
    d[x] = c[(x + 1) % 5];
    
    // D[x] = ROT(D[x], 1)
    _, _, d[x] = #ROL_64(d[x], 1);

    // D[x] ^= C[x-1]
    d[x] ^= c[(x - 1 + 5) % 5];
    
  }
  
  return d;
}

// B[x] = ROT( (A[x',y'] ^ D[x']), r[x',y'] ) with (x',y') = M^-1 (x,y)
//
// M = (0 1)  M^-1 = (1 3)  x' = 1x + 3y
//     (2 3)         (1 0)  y' = 1x + 0y
//
inline fn keccakf1600_rol_sum(
  reg ptr u64[25] a,
  reg u64[5] d,
  inline int y)
  ->
  reg u64[5]
{
  inline int r x x_ y_;
  reg u64[5] b;

  for x = 0 to 5
  {
    x_ = (x + 3*y) % 5;
    y_ = x;
    r = keccakf1600_rhotates(x_, y_);

    // B[x] = A[x',y']
    b[x] = a[x_ + y_*5];

    // B[x] ^= D[x'];
    b[x] ^= d[x_];

    // B[x] = ROT( B[x], r[x',y'] );
    if(r != 0)
    { _, _, b[x] = #ROL_64(b[x], r); }

  }
  return b;
}

// E[x, y] = B[x] ^ ( (!B[x+1]) & B[x+2] )
// -- when x and y are 0: E[0,0] ^= RC[i];
inline fn keccakf1600_set_row(
  reg ptr u64[25] e,
  reg u64[5] b,
  inline int y,
  stack u64 s_rc)
  ->
  reg ptr u64[25]
{
  inline int x x1 x2;
  reg u64 t;

  for x=0 to 5
  {
    x1 = (x + 1) % 5;
    x2 = (x + 2) % 5;

    // t  = !b[x1] & b[x2]; // bmi1
    t = b[x1]; t = !t; t &= b[x2];

    t ^= b[x];
    if( x==0 && y==0 ){ t ^= s_rc; }
    e[x + y*5] = t;
  }

  return e;
}

inline fn keccakf1600_round(
  reg ptr u64[25] e,
  reg ptr u64[25] a,
  reg u64 rc)
  ->
  reg ptr u64[25]
      {
  inline int y;
  reg u64[5] c d b;  
  stack u64 s_rc;
  
  s_rc = rc;
  
  c = keccakf1600_theta_sum(a);
  d = keccakf1600_theta_rol(c);
  
  for y = 0 to 5
  { b = keccakf1600_rol_sum(a, d, y);  
    e = keccakf1600_set_row(e, b, y, s_rc);
  }
  
  return e;
}

inline fn __keccakf1600(reg ptr u64[25] a) -> reg ptr u64[25]
{
  reg ptr u64[25] e;
  stack u64[25] s_e;
  
  inline int i;
  e = s_e;

  for i = 0 to KECCAK_ROUNDS/2
  {
    e = keccakf1600_round(e, a, KECCAK1600_RC[(int) 2*i]);
    a = keccakf1600_round(a, e, KECCAK1600_RC[(int) 2*i + 1]);
  }

  return a;
}

inline
fn __st0(reg ptr u64[25] state) -> reg ptr u64[25]
{
  inline int i;

  for i = 0 to 25 {
    state[i] = 0;
  }
  return state;
}

fn _shake256_128_33(#spill_to_mmx reg ptr u8[128] out, reg const ptr u8[33] in) -> stack u8[128]
{
  stack u64[25] state;
  reg u64 t;
  reg u8 c;
  inline int i;

  state = __st0(state);

  for i = 0 to 4 {
    t = in[u64 i];
    state[i] ^= t;
  }
 
  c = in[32];
  state[u8 32] = c;
  
  state[u8 33] ^= 0x1f;
  state[u8 SHAKE256_RATE-1] ^= 0x80;  
  
  state = __keccakf1600(state);

  for i = 0 to 16 {
    t = state[i];
    out[u64 i] = t;
  }

  return out;
}


fn _shake256_1120_32 (
    #spill_to_mmx reg ptr u8[MLKEM_SYMBYTES] out, 
    reg ptr u8[1120] in) -> reg ptr u8[32] 
{
  stack u64[25] state;
  reg u64 t64;
  inline int i j pos;

  pos = 0;
  state = __st0(state);
    
  for i = 0 to 8 // floor(1120/136) = 8
  {      
    for j = 0 to SHAKE256_RATE/8
    {
      t64 = in.[u64 (pos/8 + j)*8];
      state[u64 j] ^= t64;
    }
    
     pos += SHAKE256_RATE;
     state = __keccakf1600(state);
  }
  
  for i = 0 to 4
  {
    t64 = in.[u64 (i + pos/8)*8];
    state[i] ^= t64;
  }

  state[u8 32] ^= 0x1f;
  state[u8 SHAKE256_RATE-1] ^= 0x80;  
  
  state = __keccakf1600(state);
  
  for i=0 to MLKEM_SYMBYTES/8
  {
    t64 = state[i];
    out[u64 i] = t64;
  }

  return out;
}


fn _sha3_512_32(#spill_to_mmx reg ptr u8[64] out, reg const ptr u8[32] in) -> stack u8[64]
{
  stack u64[25] state;
  reg u8 c;
  inline int i;

  state = __st0(state);

  for i = 0 to 32 {
    c = in[i];
    state[u8 i] ^= c;
  }
  
  state[u8 32] ^= 0x06;
  state[u8 SHA3_512_RATE-1] ^= 0x80;    
  state = __keccakf1600(state);
  
  for i = 0 to 64 {
    c = state[u8 (int) i];
    out[i] = c;
  }

  return out;
}

fn _shake128_absorb34(reg ptr u64[25] state, reg const ptr u8[34] in) -> reg ptr u64[25]
{
  reg u8 c;
  reg u64 c64;
  inline int i;

  state = __st0(state);

  for i = 0 to 4 {
    c64 = in[u64 i];
    state[i] ^= c64;
  }

  for i = 0 to 2{
     c = in[i + 32];
     state[u8 (i + 32)] ^= c;
  }
  
  state[u8 34] ^= 0x1f;
  state[u8 SHAKE128_RATE-1] ^= 0x80;

  return state;
}


fn _shake128_squeezeblock(reg ptr u64[25] state, reg ptr u8[SHAKE128_RATE] out) -> reg ptr u64[25], reg ptr u8[SHAKE128_RATE]
{
  reg u64 c64;
  inline int i;
  
  state = __keccakf1600(state);
    
  for i = 0 to SHAKE128_RATE/8 {
    c64 = state[i];
    out[u64 i] = c64;
  }
  
  return state, out;
}

fn _sha3_256_1184(#spill_to_mmx reg ptr u8[32] out, reg ptr u8[MLKEM_PUBLICKEYBYTES] in) -> reg ptr u8[32]
{
  stack u64[25] state;
  reg u64 t64;
  inline int i j pos;

  pos = 0;
  state = __st0(state);
    
  for i = 0 to 8 // floor(1184/136) = 8
  {      
    for j = 0 to SHA3_256_RATE/8
    {
      t64 = in.[u64 (pos/8 + j)*8];
      state[u64 j] ^= t64;
    }
    
     pos += SHA3_256_RATE;
     state = __keccakf1600(state);
  }
  
  for i = 0 to 12
  {
    t64 = in.[u64 (i + pos/8)*8];
    state[i] ^= t64;
  }

  state[u8 96] ^= 0x06;
  state[u8 SHA3_256_RATE-1] ^= 0x80;
  state = __keccakf1600(state);
  
  for i=0 to 4
  {
    t64 = state[i];
    out[u64 i] = t64;
  }

  return out;
}


#[returnaddress="stack"]
fn _sha3_512_64(#spill_to_mmx reg ptr u8[64] out, reg const ptr u8[64] in) -> stack u8[64]
{
  stack u64[25] state;
  reg u64 t64;
  inline int i;

  state = __st0(state);

  for i = 0 to 8
  {
    t64 = in[u64 i];
    state[i] ^= t64;
  }

  state[u8 64] ^= 0x06;
  state[u8 SHA3_512_RATE - 1] ^= 0x80;
  state = __keccakf1600(state);  
  
  for i = 0 to 8
  {
    t64 = state[i];
    out[u64 i] = t64;
  }
  
  return out;
}
