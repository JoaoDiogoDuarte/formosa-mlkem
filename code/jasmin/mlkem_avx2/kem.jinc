require "indcpa.jinc"
require "verify.jinc"

inline
fn __crypto_kem_keypair_jazz(#spill_to_mmx reg ptr u8[MLKEM_PUBLICKEYBYTES] pk, #spill_to_mmx reg ptr u8[MLKEM_SECRETKEYBYTES] sk, reg ptr u8[MLKEM_SYMBYTES*2] randomnessp) -> reg ptr u8[MLKEM_PUBLICKEYBYTES], reg ptr u8[MLKEM_SECRETKEYBYTES]
{
  inline int i;
  reg u64 t64;

  stack u8[32] h_pk; 
  stack u8[MLKEM_PUBLICKEYBYTES] pk_mlkem;
  stack u8[MLKEM_SECRETKEYBYTES] sk_mlkem;
  
  stack u8[MLKEM_SYMBYTES*2] randomness;
  stack u8[MLKEM_SYMBYTES] randomness1 randomness2;
  
  () = #spill(pk, sk, randomnessp);
  
  randomness = #copy(randomnessp);
  randomness1 = randomness[0:MLKEM_SYMBYTES];
  
  pk_mlkem, sk_mlkem = __indcpa_keypair(pk_mlkem, sk_mlkem, randomness1);
  
  for i=0 to MLKEM_INDCPA_PUBLICKEYBYTES/8 { 
      t64 = pk_mlkem[u64 i]; 
      sk_mlkem[u64 MLKEM_POLYVECBYTES/8 + i] = t64; 
  }

  h_pk = _sha3_256A_A1184(h_pk, pk_mlkem);

  for i=0 to 4
  {
    t64 = h_pk[u64 i];
    sk_mlkem[u64 (MLKEM_POLYVECBYTES + MLKEM_PUBLICKEYBYTES)/8 + i] = t64;
  }

  randomness2 = randomness[MLKEM_SYMBYTES:MLKEM_SYMBYTES];

  for i=0 to MLKEM_SYMBYTES/8
  {
    t64 = randomness2[u64 i];
    sk_mlkem[u64 (MLKEM_POLYVECBYTES + MLKEM_PUBLICKEYBYTES + MLKEM_SYMBYTES)/8 + i] = t64;
  }
  
  () = #unspill(pk, sk);
  
  pk = #copy(pk_mlkem);
  sk = #copy(sk_mlkem);
  
  return pk, sk;
}

inline
fn __crypto_kem_enc_jazz(reg ptr u8[MLKEM_CIPHERTEXTBYTES] ct, reg ptr u8[MLKEM_SYMBYTES] shk, reg ptr u8[MLKEM_PUBLICKEYBYTES] pk, reg ptr u8[MLKEM_SYMBYTES] randomnessp) -> reg ptr u8[MLKEM_CIPHERTEXTBYTES], reg ptr u8[MLKEM_SYMBYTES]
{
  stack u8[MLKEM_SYMBYTES * 2] buf kr;
  stack u8[MLKEM_SYMBYTES] buf1 kr1;
  stack u8[MLKEM_PUBLICKEYBYTES] pk_mlkem;
  stack u8[MLKEM_CIPHERTEXTBYTES] ct_mlkem;
  
  () = #spill(ct, shk, pk, randomnessp);
  
  buf[0:MLKEM_SYMBYTES] = #copy(randomnessp);
  
  pk_mlkem = #copy(pk);

  buf[MLKEM_SYMBYTES:MLKEM_SYMBYTES] = _sha3_256A_A1184(buf[MLKEM_SYMBYTES:MLKEM_SYMBYTES], pk_mlkem);

  kr = _sha3_512A_A64(kr, buf);

  buf1 = buf[0:MLKEM_INDCPA_MSGBYTES];
  kr1 = kr[MLKEM_SYMBYTES:MLKEM_SYMBYTES];  
  ct_mlkem = __indcpa_enc(ct_mlkem, buf1, pk_mlkem, kr1);
  
  () = #unspill(shk, ct);
  
  shk = #copy(kr[0:32]);
  ct = #copy(ct_mlkem);  
  
  return ct, shk;
}

inline
fn __crypto_kem_dec_jazz(#spill_to_mmx reg ptr u8[MLKEM_SYMBYTES] shk, #spill_to_mmx reg ptr u8[MLKEM_CIPHERTEXTBYTES] ct, #spill_to_mmx reg ptr u8[MLKEM_SECRETKEYBYTES] sk) -> reg ptr u8[MLKEM_SYMBYTES]
{
  inline int i;
  reg u64 t64 cnd;
  #mmx reg u64 scnd;
  stack u8[2*MLKEM_SYMBYTES] kr buf;
  
  stack u8[MLKEM_SYMBYTES] ss;   
  stack u8[MLKEM_SECRETKEYBYTES] sk_mlkem; 
  stack u8[MLKEM_CIPHERTEXTBYTES] ct_mlkem ctc_mlkem;
  stack u8[MLKEM_SYMBYTES + MLKEM_CIPHERTEXTBYTES] zp_ct; // used instead of reg u64 zp
  
  () = #spill(shk, ct, sk);
  sk_mlkem = #copy(sk);
  ct_mlkem = #copy(ct);
  
  buf[0:MLKEM_INDCPA_MSGBYTES] = __indcpa_dec(buf[0:MLKEM_INDCPA_MSGBYTES], ct_mlkem, sk_mlkem);

  for i=0 to MLKEM_SYMBYTES/8
  {
    t64 = sk_mlkem[u64 i + (MLKEM_SECRETKEYBYTES-2*MLKEM_SYMBYTES)/8];
    buf[u64 i + MLKEM_SYMBYTES/8] = t64;
  }

  kr = _sha3_512A_A64(kr, buf);
  ctc_mlkem = __indcpa_enc(ctc_mlkem, buf[0:MLKEM_SYMBYTES], sk_mlkem[MLKEM_POLYVECBYTES:MLKEM_PUBLICKEYBYTES], kr[MLKEM_SYMBYTES:MLKEM_SYMBYTES]);

  cnd = __verify(ct_mlkem, ctc_mlkem);
  scnd = cnd;

  for i = 0 to MLKEM_SYMBYTES/8 
  {
      t64 = sk_mlkem[u64 i + (MLKEM_SECRETKEYBYTES-MLKEM_SYMBYTES)/8];
      zp_ct[u64 i] = t64;
  }
  
  for i = 0 to MLKEM_CIPHERTEXTBYTES/8 // equiv to passing ctp as an arg to shake 
  {
      t64 = ct_mlkem[u64 i];
      zp_ct[u64 i + MLKEM_SYMBYTES/8] = t64;
  }

  //_shake256_1120_32(shkp, zp, ctp);
  ss = _shake256_A32__A1120(ss, zp_ct);

  cnd = scnd;

  ss = __cmov(ss, kr[0:MLKEM_SYMBYTES], cnd);
  
  () = #unspill(shk);
  shk = #copy(ss);
  
  return shk; 
}
