require "../params.jinc"
require "keccakf1600.jinc"
require "fips202_common.jinc"

inline
fn __st0(reg ptr u64[25] state) -> reg ptr u64[25]
{
  inline int i;

  for i = 0 to 25 {
    state[i] = 0;
  }

  return state;
}

fn _shake256_128_33(reg ptr u8[128] out, reg ptr u8[33] in) -> stack u8[128]
{
  stack u64[25] state;
  reg u64 t;
  reg u8 c;
  inline int i;

  () = #spill(out, in);

  state = __st0(state);

  for i = 0 to 4 {
    t = in[u64 i];
    state[i] ^= t;
  }
  () = #spill(t);

  c = in[32];
  state[u8 32] = c;
  () = #spill(c);
  state[u8 33] ^= 0x1f;

  state[u8 SHAKE256_RATE-1] ^= 0x80;

  state = _keccakf1600_(state);

  () = #unspill(out, t);
  for i = 0 to 16 {
    t = state[i];
    out[u64 i] = t;
  }
  () = #spill(t);
  return out;
}


fn _shake256_32_1120 (
    #spill_to_mmx reg ptr u8[MLKEM_SYMBYTES] out, 
    reg ptr u8[1120] in) -> reg ptr u8[32] 
{
  stack u64[25] state;
  reg u64 t64;
  inline int i j pos;

  pos = 0;
  state = __st0(state);
    
  for i = 0 to 8 // floor(1120/136) = 8
  {      
    for j = 0 to SHAKE256_RATE/8
    {
      t64 = in.[u64 (pos/8 + j)*8];
      state[u64 j] ^= t64;
    }
    
     pos += SHAKE256_RATE;
     state = __keccakf1600(state);
  }
  
  for i = 0 to 4
  {
    t64 = in.[u64 (i + pos/8)*8];
    state[i] ^= t64;
  }

  state[u8 32] ^= 0x1f;
  state[u8 SHAKE256_RATE-1] ^= 0x80;  
  
  state = __keccakf1600(state);
  
  for i=0 to MLKEM_SYMBYTES/8
  {
    t64 = state[i];
    out[u64 i] = t64;
  }

  return out;
}


fn _shake128_absorb34(reg ptr u64[25] state, reg const ptr u8[34] in) -> reg ptr u64[25]
{
  reg u8 c;
  reg u64 c64;
  inline int i;
  () = #spill(in);

  state = __st0(state);

  for i = 0 to 4 {
    c64 = in[u64 i];
    state[i] ^= c64;
  }
  () = #spill(c64);

  for i = 0 to 2{
     c = in[i + 32];
     state[u8 (i + 32)] ^= c;
  }

  () = #spill(c);

  state[u8 34] ^= 0x1f;
  state[u8 SHAKE128_RATE-1] ^= 0x80;

  return state;
}


fn _shake128_squeezeblock(reg ptr u64[25] state, reg ptr u8[SHAKE128_RATE] out) -> reg ptr u64[25], reg ptr u8[SHAKE128_RATE]
{
  reg u64 c64;
  inline int i;
  () = #spill(out);
  state = _keccakf1600_(state);
  () = #spill(state);
  () = #unspill(out);
  for i = 0 to SHAKE128_RATE/8 {
    c64 = state[i];
    out[u64 i] = c64;
  }
  () = #spill(c64);
  return state, out;
}

inline fn _sha3_512_32(reg ptr u8[64] out, reg ptr u8[32] in) -> stack u8[64]
{
  stack u64[25] state;
  reg u64 t;
  inline int i;

  () = #spill(out, in);

  state = __st0(state);

  for i = 0 to 4 {
    t = in[u64 i];
    state[i] ^= t;
  }
  () = #spill(t);

  state[u8 32] ^= 0x06;
  state[u8 SHA3_512_RATE-1] ^= 0x80;

  state = _keccakf1600_(state);

  () = #unspill(t, out);

  for i = 0 to 8 {
    t = state[i];
    out[u64 i] = t;
  }
  () = #spill(t);

  return out;
}


fn _sha3_256_1184(reg ptr u8[32] out, reg ptr u8[MLKEM_PUBLICKEYBYTES] in) -> reg ptr u8[32]
{
  stack u64[25] state;
  reg u64 t64;
  inline int i j pos;

  () = #spill(out, in);

  pos = 0;
  state = __st0(state);

  () = #spill(t64);
  for i = 0 to 8 // floor(1184/136) = 8
  {
    () = #unspill(t64);

    for j = 0 to SHA3_256_RATE/8
    {
      t64 = in.[u64 (pos/8 + j)*8];
      state[u64 j] ^= t64;
    }
    () = #spill(t64);

     pos += SHA3_256_RATE;
     state = _keccakf1600_(state);
  }

  () = #unspill(t64);
  for i = 0 to 12
  {
    t64 = in.[u64 (i + pos/8)*8];
    state[i] ^= t64;
  }

  () = #spill(t64);

  state[u8 96] ^= 0x06;

  state[u8 SHA3_256_RATE-1] ^= 0x80;

  state = _keccakf1600_(state);

  () = #unspill(out);
  for i=0 to 4
  {
    t64 = state[i];
    out[u64 i] = t64;
  }
  () = #spill(t64);

  return out;
}

#[returnaddress="stack"]
fn _sha3_512_64(reg ptr u8[64] out, reg const ptr u8[64] in) -> stack u8[64]
{
  stack u64[25] state;
  reg u64 t64;
  inline int i;

  () = #spill(out);

  state = __st0(state);

  for i = 0 to 8
  {
    t64 = in[u64 i];
    state[i] ^= t64;
  }

  () = #spill(t64, in);

  state[u8 64] ^= 0x06;
  state[u8 SHA3_512_RATE - 1] ^= 0x80;

  state = _keccakf1600_(state);

  () = #unspill(t64, out);
  for i = 0 to 8
  {
    t64 = state[i];
    out[u64 i] = t64;
  }
  () = #spill(t64);
  return out;
}
