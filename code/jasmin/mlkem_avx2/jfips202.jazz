{
  stack u8[32] in;
  stack u8[64] out;
  stack u64 soutp;
  reg u64 c;
  inline int i;

  for i = 0 to 4 {
    c = (u64)[inp + 8*i];
    in.[u64 8*i] = c;
  }

  soutp = outp;
