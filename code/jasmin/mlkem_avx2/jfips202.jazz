require "params.jinc"
require "mlkem_keccak_avx2_TRANSITION.jinc"

export fn shake256_128_33_jazz(reg u64 outp inp)
{
  stack u8[32] in;
  stack u8[1] in1;
  stack u8[128] out;
  stack u64 soutp;
  reg u8 c;
  reg u64 t;
  inline int i;

  for i = 0 to 4 {
    t = (u64)[inp + 8*i];
    in.[u64 8*i] = t;
  }
  
  c = (u8)[inp+32];
  in1.[u8 0] = c;

  soutp = outp;
  out = _shake256_A128__A32_A1(out, in, in1);
  outp = soutp;

  for i = 0 to 16 {
    t = out.[u64 8*i];
    (u64)[outp + 8*i] = t;
  }
}

export fn shake256_1120_32_jazz(reg u64 outp inp)
{
  stack u8[1120] in;  
  stack u8[32] out;
  stack u64 soutp;
  reg u64 c;
  inline int i;

  for i = 0 to 1120/8 {
    c = (u64)[inp + 8*i];
    in.[u64 8*i] = c;
  }

  soutp = outp;
  out = _shake256_A32__A1120(out, in);
  outp = soutp;

  for i = 0 to 4 {
    c = out.[u64 8*i];
    (u64)[outp + 8*i] = c;
  }
}

