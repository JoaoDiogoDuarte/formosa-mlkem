require "kem.jinc"

// Reg interface -> stack internal
// Only here for testing purposes
export fn jade_kem_mlkem_mlkem768_amd64_avx2_keypair_derand(reg u64 public_key secret_key coins) -> reg u64
{
  reg u64 r t;
  stack u8[MLKEM_SYMBYTES*2] randomness;
  stack u8[MLKEM_PUBLICKEYBYTES] pk;
  stack u8[MLKEM_SECRETKEYBYTES] sk;
  inline int i;

  _ = #init_msf();

  public_key = public_key;
  secret_key = secret_key;

  for i = 0 to MLKEM_SYMBYTES*2
  {
     randomness[i] = (u8)[coins + i];
  }

  () = #spill(public_key, secret_key, coins); // Extra spill as this is only for testing

  pk, sk = __crypto_kem_keypair_jazz(pk, sk, randomness);
 () = #spill(public_key, secret_key, coins);
  for i=0 to MLKEM_PUBLICKEYBYTES/8 { t = pk[u64 i]; [public_key + 8*i] = t; }
  for i=0 to MLKEM_SECRETKEYBYTES/8 { t = sk[u64 i]; [secret_key + 8*i] = t; }
  ?{}, r = #set0();
  return r;
}

export fn jade_kem_mlkem_mlkem768_amd64_avx2_enc_derand(reg u64 ciphertext shared_secret public_key coins) -> reg u64
{
  reg u64 r t;
  stack u8[MLKEM_SYMBYTES] randomness;
  stack u8[MLKEM_CIPHERTEXTBYTES] ct;
  stack u8[MLKEM_SYMBYTES] shk;
  stack u8[MLKEM_PUBLICKEYBYTES] pk;
  reg ptr u8[MLKEM_PUBLICKEYBYTES] pkp;
  inline int i;

  _ = #init_msf();

  ciphertext = ciphertext;
  shared_secret = shared_secret;
  pkp = pk;

  for i = 0 to MLKEM_SYMBYTES 
  {
     randomness[i] = (u8)[coins + i];
  }
  for i = 0 to MLKEM_PUBLICKEYBYTES/8 { pk[u64 i]   = [public_key + 8*i]; }
  () = #spill(ciphertext, shared_secret, public_key, coins, pkp); // Extra spill as this is only for testing
  
  ct, shk = __crypto_kem_enc_jazz(ct, shk, pkp, randomness);
  
  () = #unspill(ciphertext, shared_secret);
  for i=0 to MLKEM_SYMBYTES/8 { t = shk[u64 i]; [shared_secret + 8*i] = t; }
  for i=0 to MLKEM_CIPHERTEXTBYTES/8 { t = ct[u64 i]; [ciphertext + 8*i] = t; }
  ?{}, r = #set0();
  return r;
}


export fn jade_kem_mlkem_mlkem768_amd64_avx2_dec(reg u64 shared_secret ciphertext secret_key) -> reg u64
{
  reg u64 r t;
  stack u8[MLKEM_CIPHERTEXTBYTES] ct;
  stack u8[MLKEM_SYMBYTES] shk;
  stack u8[MLKEM_SECRETKEYBYTES] sk;
  reg ptr u8[MLKEM_SECRETKEYBYTES] skp;
  reg ptr u8[MLKEM_CIPHERTEXTBYTES] ctp;
  inline int i;

  _ = #init_msf();

  for i = 0 to MLKEM_SECRETKEYBYTES/8 { sk[u64 i] = [secret_key + 8*i]; }
  for i = 0 to MLKEM_CIPHERTEXTBYTES/8 { ct[u64 i] = [ciphertext + 8*i]; }

  shared_secret = shared_secret;
  ctp = ct;
  skp = sk;
  () = #spill(ctp, skp, shared_secret, ciphertext, secret_key);

shk = __crypto_kem_dec_jazz(shk, ctp, skp);

  () = #unspill(shared_secret);
  for i=0 to MLKEM_SYMBYTES/8 { t = shk[u64 i]; [shared_secret + 8*i] = t; }
  ?{}, r = #set0();
  return r;
}
